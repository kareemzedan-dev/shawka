{
  "name": "shawka-functions",
  "description": "Cloud Functions for Shawka",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/**/*.e2e.test.js",
    "test:e2e:emulator": "firebase emulators:exec --project demo-matlobgo-e2e --only firestore \"npm run test:e2e\"",
    "test:e2e:coverage": "npx c8 --reporter=text --reporter=html --include=assignment/** --include=driver/** --include=shared/** --include=jobQueue.js npm run test:e2e"
  },
  "dependencies": {
    "@firebase/app": "^0.14.13",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "ngeohash": "^0.6.3"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "private": true
}
